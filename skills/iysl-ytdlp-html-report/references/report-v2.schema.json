{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iysl.local/schemas/ytdlp-html-report-v2.schema.json",
  "title": "iysl-ytdlp-html-report v2",
  "description": "Transcript-grounded structured report contract. The brief is the scan layer and is evidence-governed like every other reader-facing claim. Thumbnail metadata is a media anchor and is never semantic evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "source",
    "reading_minutes",
    "brief",
    "evidence",
    "blocks",
    "topic_coverage"
  ],
  "properties": {
    "version": {
      "const": "2.3"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "subtitle": {
      "type": "string"
    },
    "language": {
      "const": "zh-Hant"
    },
    "brief": {
      "$ref": "#/$defs/brief"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video_id",
        "url",
        "transcript_kind"
      ],
      "properties": {
        "video_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "$ref": "#/$defs/httpUrl"
        },
        "channel": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "thumbnail_url": {
          "$ref": "#/$defs/mediaUrl"
        },
        "transcript_kind": {
          "enum": [
            "native_captions",
            "auto_captions",
            "audio_asr"
          ]
        }
      }
    },
    "reading_minutes": {
      "$comment": "讀完這份報告的預估分鐘數，由讀者文字長度推導；validate_report_v2.mjs 會重算並要求相符，不可自行填寫。",
      "type": "integer",
      "minimum": 1
    },
    "topic_coverage": {
      "$ref": "#/$defs/topicCoverage"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "allOf": [
        {
          "contains": {
            "oneOf": [
              {
                "$ref": "#/$defs/narrativeBlock"
              },
              {
                "$ref": "#/$defs/processBlock"
              },
              {
                "$ref": "#/$defs/comparisonBlock"
              },
              {
                "$ref": "#/$defs/controlGapBlock"
              },
              {
                "$ref": "#/$defs/spotlightBlock"
              }
            ]
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/keyPointsBlock"
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/foodForThoughtBlock"
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/actionsBlock"
          }
        }
      ],
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/narrativeBlock"
          },
          {
            "$ref": "#/$defs/processBlock"
          },
          {
            "$ref": "#/$defs/comparisonBlock"
          },
          {
            "$ref": "#/$defs/controlGapBlock"
          },
          {
            "$ref": "#/$defs/spotlightBlock"
          },
          {
            "$ref": "#/$defs/actionsBlock"
          },
          {
            "$ref": "#/$defs/keyPointsBlock"
          },
          {
            "$ref": "#/$defs/foodForThoughtBlock"
          }
        ]
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s\\r\\n]+$"
    },
    "mediaUrl": {
      "anyOf": [
        {
          "$ref": "#/$defs/httpUrl"
        },
        {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!file:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._~!$&'()+,;=@%/-]+$"
        }
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "claimType": {
      "enum": [
        "speaker_claim",
        "report_synthesis",
        "open_question"
      ]
    },
    "salienceSignal": {
      "enum": [
        "concrete_metric",
        "decision",
        "counterintuitive_claim",
        "anecdote",
        "tradeoff",
        "specific_example",
        "product_image",
        "failure_or_recovery",
        "core_claim",
        "narrative_context",
        "caveat",
        "open_question"
      ]
    },
    "topicCoverage": {
      "$comment": "先完整掃過 opening、middle、ending，再把每個有語意的 topic 映射到實際 reader block；高顯著性只決定是否用 spotlight 放大。這是 semantic completeness contract，不是第五章。",
      "type": "object",
      "additionalProperties": false,
      "required": ["sweep", "topics"],
      "properties": {
        "sweep": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opening", "middle", "ending"],
          "properties": {
            "opening": {"$ref": "#/$defs/topicIds"},
            "middle": {"$ref": "#/$defs/topicIds"},
            "ending": {"$ref": "#/$defs/topicIds"}
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "salience_signals", "evidence_refs", "block_ids"],
            "properties": {
              "id": {"$ref": "#/$defs/nonEmptyString"},
              "title": {"$ref": "#/$defs/nonEmptyString"},
              "salience_signals": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/salienceSignal"}
              },
              "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
              "block_ids": {"$ref": "#/$defs/topicIds"}
            }
          }
        }
      }
    },
    "topicIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "transcript_quote"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "transcript_quote": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "blockBase": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "claim_type",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "summary": {
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/claimType"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "$comment": "block 的 title 不可與它所屬章節同名（內容重述／洞見／food for thoughts／可行啟發）：同一句話講兩次會讓掃標題那一層的閱讀失效。這條由 validate_report_v2.mjs 強制。"
    },
    "visualItemBase": {
      "type": "object",
      "required": [
        "evidence_refs"
      ],
      "properties": {
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "narrativeBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "claim_type",
            "evidence_refs",
            "paragraphs"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "narrative"
            },
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "summary": {
              "type": "string"
            },
            "claim_type": {
              "$ref": "#/$defs/claimType"
            },
            "evidence_refs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "paragraphs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "evidence_refs"
                ],
                "properties": {
                  "text": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "evidence_refs": {
                    "$ref": "#/$defs/evidenceRefs"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "processBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "claim_type",
            "evidence_refs",
            "nodes"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "process"
            },
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "summary": {
              "type": "string"
            },
            "claim_type": {
              "$ref": "#/$defs/claimType"
            },
            "evidence_refs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/visualItemBase"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "evidence_refs"
                    ],
                    "properties": {
                      "label": {
                        "$ref": "#/$defs/nonEmptyString"
                      },
                      "detail": {
                        "type": "string"
                      },
                      "evidence_refs": {
                        "$ref": "#/$defs/evidenceRefs"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "comparisonBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "claim_type",
            "evidence_refs",
            "columns",
            "rows"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "comparison"
            },
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "summary": {
              "type": "string"
            },
            "claim_type": {
              "$ref": "#/$defs/claimType"
            },
            "evidence_refs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "columns": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "values",
                  "evidence_refs"
                ],
                "properties": {
                  "label": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "values": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence_refs": {
                    "$ref": "#/$defs/evidenceRefs"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "controlGapBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "claim_type",
            "evidence_refs",
            "rows"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "control-gap"
            },
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "summary": {
              "type": "string"
            },
            "claim_type": {
              "$ref": "#/$defs/claimType"
            },
            "evidence_refs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "control",
                  "observed",
                  "gap",
                  "evidence_refs"
                ],
                "properties": {
                  "control": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "observed": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "gap": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "evidence_refs": {
                    "$ref": "#/$defs/evidenceRefs"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "spotlightBlock": {
      "allOf": [
        {"$ref": "#/$defs/blockBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "title", "claim_type", "evidence_refs", "angle", "items"],
          "properties": {
            "id": {"$ref": "#/$defs/nonEmptyString"},
            "type": {"const": "spotlight"},
            "title": {"$ref": "#/$defs/nonEmptyString"},
            "summary": {"type": "string"},
            "claim_type": {"$ref": "#/$defs/claimType"},
            "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
            "angle": {"$ref": "#/$defs/salienceSignal"},
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["heading", "text", "evidence_refs"],
                "properties": {
                  "heading": {"$ref": "#/$defs/nonEmptyString"},
                  "text": {"$ref": "#/$defs/nonEmptyString"},
                  "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
                }
              }
            }
          }
        }
      ]
    },
    "actionsBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "claim_type",
            "evidence_refs",
            "items"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "actions"
            },
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "summary": {
              "type": "string"
            },
            "claim_type": {
              "$ref": "#/$defs/claimType"
            },
            "evidence_refs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "evidence_refs"
                ],
                "properties": {
                  "action": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "when": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "$ref": "#/$defs/evidenceRefs"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "keyPointsBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "claim_type",
            "evidence_refs",
            "items"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "key-points"
            },
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "summary": {
              "type": "string"
            },
            "claim_type": {
              "$ref": "#/$defs/claimType"
            },
            "evidence_refs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "heading",
                  "text",
                  "evidence_refs"
                ],
                "properties": {
                  "heading": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "text": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "evidence_refs": {
                    "$ref": "#/$defs/evidenceRefs"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "foodForThoughtBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/blockBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "claim_type",
            "evidence_refs",
            "items"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "type": {
              "const": "food-for-thought"
            },
            "title": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "summary": {
              "type": "string"
            },
            "claim_type": {
              "$ref": "#/$defs/claimType"
            },
            "evidence_refs": {
              "$ref": "#/$defs/evidenceRefs"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prompt",
                  "evidence_refs"
                ],
                "properties": {
                  "prompt": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "context": {
                    "type": "string"
                  },
                  "evidence_refs": {
                    "$ref": "#/$defs/evidenceRefs"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "briefClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "claim_type",
        "evidence_refs"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "claim_type": {
          "enum": [
            "speaker_claim",
            "report_synthesis"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "briefTakeaway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence_refs"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      }
    },
    "brief": {
      "$comment": "掃讀層。claim 回答「這支影片在吵什麼」，takeaways 是可單獨引用的一句話版；每一項各自帶 evidence_refs，不共用。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "takeaways"
      ],
      "properties": {
        "claim": {
          "$ref": "#/$defs/briefClaim"
        },
        "takeaways": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/briefTakeaway"
          }
        }
      }
    }
  }
}
