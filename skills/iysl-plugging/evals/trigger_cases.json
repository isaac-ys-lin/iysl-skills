      "text": "Use the data analytics plugin to diagnose this metric.",
      "family": "ordinary_plugin_use"
    },
    {
      "text": "Install the Notion plugin.",
      "family": "plugin_installation"
    },
    {
      "text": "Which plugins are available?",
      "family": "plugin_discovery"
    },
    {
      "text": "Disable GitHub globally.",
      "family": "plugin_management"
    }
  ],
  "near_neighbor": [
    {
      "text": "Read this one local SKILL.md file.",
