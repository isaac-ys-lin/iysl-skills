{
  "cases": [
    {
      "id": "explicit-blind-handoff",
      "kind": "simple",
      "prompt": "把這個 repo 打包給另一個看不到原始碼的 AI，讓它能回答架構與目前行為。",
      "expected": {"max_questions": 0, "max_subagents": 0, "must_do": ["produce one self-contained Markdown handoff"]}
    },
    {
      "id": "ordinary-review-is-not-packaging",
      "kind": "negative",
      "prompt": "只 review 目前 diff，回報 actionable findings，不要產生 handoff。",
      "expected": {"max_questions": 0, "must_not_do": ["generate a research pack"]}
    },
    {
      "id": "secret-and-generated-exclusion",
      "kind": "failure",
      "prompt": "研究這個包含 .env、generated build 與 node_modules 的 fixture，並交給另一個 AI。",
      "expected": {"must_do": ["exclude secrets", "exclude generated outputs", "exclude dependencies"], "required_validation": ["secret scan", "relative path scan"]}
    },
    {
      "id": "evidence-budget-escalation",
      "kind": "complex",
      "prompt": "packager 產出超過字元 budget，但刪 evidence 會讓 receiver 無法回答 primary flow。",
      "expected": {"must_do": ["improve evidence density or split the question"], "must_not_do": ["silently remove load-bearing evidence"]}
    }
  ]
}
